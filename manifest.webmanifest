{
  "id": "./",
  "name": "星轨档案库 · Stellar Archive",
  "short_name": "星轨档案库",
  "description": "玩家自制的《崩坏：星穹铁道》静态战斗数据档案库：角色、光锥、遗器、敌人与历代高难关卡，可回溯、可对比、可离线查阅。非官方工具。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070b16",
  "theme_color": "#070b16",
  "categories": ["books", "reference", "games"],
  "icons": [
    {
      "src": "./assets/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "历代关卡",
      "short_name": "关卡",
      "description": "混沌回忆、末日幻影、虚构叙事与异相仲裁轮换档案",
      "url": "./#/stages",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "角色档案",
      "short_name": "角色",
      "description": "已上线角色数值、技能倍率与版本快照",
      "url": "./#/characters",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "未实机前瞻",
      "short_name": "前瞻",
      "description": "隔离展示测试服与埋包内容，带强警示标记",
      "url": "./#/unreleased",
      "icons": [{ "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "prefer_related_applications": false
}
